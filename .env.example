# ============================================================
# MEDIQ — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Stripe ───────────────────────────────────────────────────
VITE_STRIPE_PUBLIC_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Patient Plus monthly price ID (9.99 BGN / €5.11)
STRIPE_PLUS_MONTHLY_PRICE_ID=price_xxxxx
# Patient Plus annual price ID (99.98 BGN / €51.12)
STRIPE_PLUS_ANNUAL_PRICE_ID=price_xxxxx

# ── Google Maps ──────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── OpenAI ───────────────────────────────────────────────────
VITE_OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_KEY=sk-your-openai-api-key

# ── Twilio (SMS / Viber reminders) ───────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ── Resend (transactional email) ─────────────────────────────
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@mediq.bg

# ── Expo (Mobile) ────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your-stripe-publishable-key
